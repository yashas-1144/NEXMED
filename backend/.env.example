# BioMedAI Backend — Environment Variables
#
# Copy this file to .env (in the backend/ directory) and adjust values.
#   cp backend/.env.example backend/.env

# Flask port
PORT=5000

# Path to the MobileViT checkpoint directory.
# Can be absolute or relative to the project root.
# Default (if unset): mobilevit/mobilevit
MODEL_PATH=mobilevit/mobilevit

# Set to true to enable Flask debug mode (never use in production)
FLASK_DEBUG=false
